---
import AdminLayout from '../../layouts/AdminLayout.astro';
import TexturePreload from '../../components/TexturePreload.astro';
import { family } from '../../data/family';
import { adminScene } from '../../data/load-scene';

// Everything the script needs arrives as data on #admin-root, so it is bundled into an external file
// (the page's CSP forbids inline scripts) and needs no fetch to start.
const rooms = family.map(({ slug, name, colors }) => ({ slug, name, colors }));

const button =
	'rounded-full px-3 py-1.5 text-sm font-medium outline-offset-2 focus-visible:outline-2 focus-visible:outline-stone-900 disabled:cursor-not-allowed disabled:opacity-40';
const quiet = `${button} text-stone-700 ring-1 ring-stone-300 hover:bg-stone-100`;
const solid = `${button} bg-stone-900 text-white hover:bg-stone-700`;
const field =
	'w-full rounded-lg border border-stone-300 bg-white px-2.5 py-1.5 text-sm text-stone-900 outline-offset-2 focus-visible:outline-2 focus-visible:outline-stone-900';
const label = 'block text-xs font-medium text-stone-500';
const heading = 'font-heading text-base font-semibold text-stone-900';

const transformFields = [
	{ key: 'position', title: 'Position', step: '0.05' },
	{ key: 'rotation', title: 'Rotation °', step: '1' },
	{ key: 'scale', title: 'Scale', step: '0.05' },
];
---

<AdminLayout title="Scene admin · Alishly">
	<TexturePreload slot="head" />
	<div
		id="admin-root"
		data-bundled={JSON.stringify(adminScene)}
		data-rooms={JSON.stringify(rooms)}
		class="flex h-dvh"
	>
		<aside
			aria-label="Editor"
			class="w-96 shrink-0 space-y-6 overflow-y-auto border-r border-stone-200 bg-white p-5"
		>
			<header class="space-y-3">
				<h1 class="font-heading text-2xl font-semibold">Scene admin</h1>
				<div class="flex items-center gap-3">
					<label for="room-select" class="sr-only">Room</label>
					<select id="room-select" class={field}>
						{rooms.map((room) => <option value={room.slug}>{room.name}'s room</option>)}
					</select>
				</div>
				<div class="flex items-end gap-2">
					<div>
						<label for="room-wall-color" class={label}>Wall colour of this room</label>
						<input
							type="color"
							id="room-wall-color"
							class="h-9 w-14 cursor-pointer rounded-lg border border-stone-300 bg-white p-1"
						/>
					</div>
					<button type="button" id="room-wall-reset" class={quiet}>Reset to default</button>
				</div>
				<p
					id="unsaved-indicator"
					data-dirty="false"
					class="inline-flex items-center gap-2 text-sm text-stone-500 data-[dirty=true]:font-medium data-[dirty=true]:text-amber-700"
				>
					<span
						aria-hidden="true"
						class="size-2 rounded-full bg-stone-300 in-data-[dirty=true]:bg-amber-500"></span>
					<span id="unsaved-text">All changes saved</span>
				</p>
			</header>

			<section aria-labelledby="catalog-heading" class="space-y-2">
				<h2 id="catalog-heading" class={heading}>Add to room</h2>
				<div id="catalog" class="flex flex-wrap gap-2"></div>
			</section>

			<section aria-labelledby="tools-heading" class="space-y-3">
				<h2 id="tools-heading" class={heading}>Move, rotate, scale</h2>
				<div class="flex gap-2" role="group" aria-label="Transform mode">
					<button
						type="button"
						id="mode-translate"
						aria-pressed="true"
						class={`${quiet} aria-pressed:bg-stone-900 aria-pressed:text-white aria-pressed:ring-stone-900`}
						>Move <kbd class="ml-1 text-xs opacity-60">W</kbd></button
					>
					<button
						type="button"
						id="mode-rotate"
						aria-pressed="false"
						class={`${quiet} aria-pressed:bg-stone-900 aria-pressed:text-white aria-pressed:ring-stone-900`}
						>Rotate <kbd class="ml-1 text-xs opacity-60">E</kbd></button
					>
					<button
						type="button"
						id="mode-scale"
						aria-pressed="false"
						class={`${quiet} aria-pressed:bg-stone-900 aria-pressed:text-white aria-pressed:ring-stone-900`}
						>Scale <kbd class="ml-1 text-xs opacity-60">R</kbd></button
					>
				</div>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" id="opt-snap" checked class="size-4 accent-stone-900" />
					Snap (0.25 grid, 15°, 0.1 scale)
				</label>
				<label class="flex items-center gap-2 text-sm">
					<input type="checkbox" id="opt-bounds" checked class="size-4 accent-stone-900" />
					Keep inside the room
				</label>
			</section>

			<section aria-labelledby="selection-heading" class="space-y-3">
				<h2 id="selection-heading" class={heading}>Selected object</h2>
				<p id="selection-empty" class="text-sm text-stone-500">
					Click an object in the room, or add one above.
				</p>
				<div id="selection-panel" hidden class="space-y-3">
					<p class="text-sm"><strong id="selection-label" class="font-medium">Object</strong></p>
					<div class="flex items-end gap-2">
						<div>
							<label for="sel-color" class={label}>Colour</label>
							<input
								type="color"
								id="sel-color"
								class="h-9 w-14 cursor-pointer rounded-lg border border-stone-300 bg-white p-1"
							/>
						</div>
						<button type="button" id="sel-color-reset" class={quiet}>Reset colour</button>
					</div>
					{
						transformFields.map((group) => (
							<fieldset>
								<legend class={label}>{group.title}</legend>
								<div class="mt-1 grid grid-cols-3 gap-2">
									{[0, 1, 2].map((axis) => (
										<input
											type="number"
											step={group.step}
											data-field={`${group.key}-${axis}`}
											aria-label={`${group.title} ${'XYZ'[axis]}`}
											class={field}
										/>
									))}
								</div>
							</fieldset>
						))
					}
					<div class="flex gap-2">
						<button type="button" id="btn-duplicate" class={quiet}
							>Duplicate <kbd class="ml-1 text-xs opacity-60">Ctrl+D</kbd></button
						>
						<button
							type="button"
							id="btn-delete"
							class={`${quiet} text-red-700 ring-red-200 hover:bg-red-50`}
							>Delete <kbd class="ml-1 text-xs opacity-60">Del</kbd></button
						>
					</div>
				</div>
				<p class="text-xs text-stone-500">
					<kbd>Esc</kbd> deselects. Drag empty space to turn the view, scroll to zoom.
				</p>
			</section>

			<section id="settings-section" aria-labelledby="settings-heading" class="space-y-3">
				<h2 id="settings-heading" class={heading}>Scene settings</h2>
				<p class="text-xs text-stone-500">
					These apply to every room. The wall colour above is per room.
				</p>
				<div id="settings-panel" class="space-y-2"></div>
			</section>

			<section aria-labelledby="github-heading" class="space-y-3">
				<h2 id="github-heading" class={heading}>Save to GitHub</h2>
				<details id="github-settings" class="text-sm">
					<summary class="cursor-pointer text-stone-600">Repository settings</summary>
					<div class="mt-3 grid grid-cols-2 gap-2">
						<div>
							<label for="gh-owner" class={label}>Owner</label>
							<input id="gh-owner" autocomplete="off" spellcheck="false" class={field} />
						</div>
						<div>
							<label for="gh-repo" class={label}>Repository</label>
							<input id="gh-repo" autocomplete="off" spellcheck="false" class={field} />
						</div>
						<div>
							<label for="gh-branch" class={label}>Branch</label>
							<input id="gh-branch" autocomplete="off" spellcheck="false" class={field} />
						</div>
						<div>
							<label for="gh-path" class={label}>File</label>
							<input id="gh-path" autocomplete="off" spellcheck="false" class={field} />
						</div>
					</div>
				</details>

				<div>
					<label for="gh-token" class={label}>Access token</label>
					<input
						type="password"
						id="gh-token"
						autocomplete="new-password"
						spellcheck="false"
						placeholder="Fine-grained token, Contents: read and write"
						class={field}
					/>
				</div>
				<div class="flex items-center justify-between gap-2">
					<label class="flex items-center gap-2 text-sm">
						<input type="checkbox" id="gh-remember" class="size-4 accent-stone-900" />
						Remember on this device
					</label>
					<button type="button" id="gh-forget" class={quiet}>Forget token</button>
				</div>

				<div class="flex gap-2">
					<button type="button" id="gh-load" class={quiet}>Load latest</button>
				</div>

				<div>
					<label for="gh-message" class={label}>Commit message</label>
					<input id="gh-message" value="Update room scenes via admin" class={field} />
				</div>
				<button type="button" id="gh-save" class={`${solid} w-full`}>Save to GitHub</button>

				<p id="gh-status" role="status" aria-live="polite" data-kind="info" class="text-sm text-stone-600 data-[kind=error]:text-red-700 data-[kind=success]:text-green-800"></p>
				<div id="gh-conflict" hidden class="flex flex-wrap gap-2">
					<button type="button" id="gh-reload" class={quiet}>Reload (discard my edits)</button>
					<button type="button" id="gh-overwrite" class={quiet}>Overwrite with my version</button>
				</div>
				<ul id="admin-warnings" hidden class="list-disc space-y-1 pl-5 text-xs text-amber-800"></ul>
			</section>
		</aside>

		<main class="relative min-w-0 flex-1">
			<canvas
				id="admin-canvas"
				role="img"
				aria-label="Editable isometric view of the room."
				class="block h-full w-full"></canvas>
			<p
				id="admin-no-webgl"
				hidden
				role="alert"
				class="absolute inset-0 m-auto h-fit max-w-xs px-6 text-center text-stone-600"
			>
				The editor needs WebGL, and it isn't available in this browser.
			</p>
		</main>
	</div>
</AdminLayout>

<script>
	import { mountAdmin } from '../../scripts/admin/main';

	const root = document.getElementById('admin-root');
	if (root) mountAdmin(root);
</script>
