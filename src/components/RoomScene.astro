---
import type { FamilyMember, RoomColors } from '../data/family';
import type { SceneObject } from '../data/scene';
import type { SceneSettings } from '../data/scene-settings';

interface Props {
	member: FamilyMember;
	/** The room's furniture from scene.json, already validated. */
	objects?: SceneObject[];
	/** The colours to draw: family.ts, or the wall colour override from scene.json (effectiveColors). */
	colors?: RoomColors;
	/** The global look from scene.json (complete, validated). Omitted = the defaults. */
	settings?: SceneSettings;
}

const { member, objects = [], colors = member.colors, settings } = Astro.props;
// `<` is written as \u003c (same JSON): user text in the attribute never contains a literal tag.
const config = JSON.stringify({ name: member.name, colors, objects, settings }).replace(/</g, '\\u003c');
---

{/*
	The outer element is NOT persisted, so on every navigation it is the new page's copy and
	its data-room always describes the room being shown. The inner element is persisted: the
	live canvas (and its WebGL context) is carried over from the previous room page.
*/}
<div data-room={config} class="absolute inset-0">
	<div transition:persist="room-scene" transition:animate="none" class="relative h-full w-full">
		<canvas
			role="img"
			aria-label={`Isometric 3D view of ${member.name}'s room. Drag to rotate, scroll or pinch to zoom.`}
			class="block h-full w-full"></canvas>
		{/* Notes (objects with a paragraph): a keyboard list and the popup. Filled in by scripts/room-interact.ts; text goes in with textContent only. */}
		<ul data-note-list role="list" aria-label="Notes in this room" class="absolute top-14 left-4 z-20 m-0 list-none p-0"></ul>
		<div data-note-layer class="pointer-events-none absolute inset-0 overflow-hidden">
			<div
				data-note-popup
				role="dialog"
				aria-labelledby="note-heading"
				hidden
				class="pointer-events-auto absolute top-0 left-0 z-10 flex w-80 max-w-[calc(100%-1rem)] flex-col rounded-2xl bg-white text-stone-700 shadow-lg ring-1 ring-stone-200 data-[layout=sheet]:top-auto data-[layout=sheet]:bottom-0 data-[layout=sheet]:w-full data-[layout=sheet]:max-w-none data-[layout=sheet]:rounded-b-none data-[layout=sheet]:pb-[env(safe-area-inset-bottom)]"
			>
				<button
					type="button"
					data-note-close
					aria-label="Close note"
					class="absolute top-1 right-1 z-10 inline-flex h-11 w-11 items-center justify-center rounded-full text-xl leading-none text-stone-600 outline-offset-2 hover:bg-stone-100 hover:text-stone-900 focus-visible:outline-2 focus-visible:outline-stone-900"
					><span aria-hidden="true">✕</span></button
				>
				<div
					data-note-body
					tabindex="0"
					role="region"
					aria-label="Note text"
					class="min-h-0 overflow-y-auto overscroll-contain rounded-2xl px-4 pt-3 pb-4 outline-offset-[-2px] focus-visible:outline-2 focus-visible:outline-stone-900"
				>
					<span aria-hidden="true" class="float-right h-8 w-10"></span>
					<h2 id="note-heading" data-note-title hidden class="font-heading mb-2 text-lg leading-snug text-stone-900 [overflow-wrap:anywhere]"></h2>
					<p data-note-text class="m-0 text-sm leading-relaxed whitespace-pre-line text-stone-700 [overflow-wrap:anywhere]"></p>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	import { createRoomScene } from '../scripts/room-scene';
	import type { RoomConfig, RoomSceneHandle } from '../scripts/room-scene';
	import type { TransitionBeforeSwapEvent } from 'astro:transitions/client';

	// Module-level singleton: at most one scene (one renderer, one canvas) at any time.
	let scene: RoomSceneHandle | null = null;
	let sceneCanvas: HTMLCanvasElement | null = null;
	// A canvas whose context was force-lost cannot get a new one, so never reuse it.
	const spent = new WeakSet<HTMLCanvasElement>();

	function disposeScene() {
		if (sceneCanvas) spent.add(sceneCanvas);
		scene?.dispose();
		scene = null;
		sceneCanvas = null;
	}

	function readConfig(root: Element | null): RoomConfig | null {
		try {
			return root ? (JSON.parse(root.getAttribute('data-room') ?? '') as RoomConfig) : null;
		} catch {
			return null;
		}
	}

	// Reconcile the scene with whatever page is on screen. Idempotent: calling it any
	// number of times in a row never creates a second renderer.
	function sync() {
		const root = document.querySelector('[data-room]');
		const config = readConfig(root);
		let canvas = root?.querySelector('canvas') ?? null;
		if (!root || !config || !canvas) {
			disposeScene(); // e.g. the picker page
			return;
		}
		if (scene && sceneCanvas === canvas && canvas.isConnected) {
			scene.setRoom(config); // persisted canvas: swap the room in place
			return;
		}
		disposeScene();
		if (spent.has(canvas)) {
			const fresh = canvas.cloneNode(false) as HTMLCanvasElement;
			canvas.replaceWith(fresh);
			canvas = fresh;
		}
		scene = createRoomScene(canvas, config);
		sceneCanvas = canvas;
	}

	// This module runs once per document, but guard anyway (HMR can re-evaluate it) so
	// listeners are never registered twice.
	const flag = window as typeof window & { __roomSceneBound?: boolean };
	if (!flag.__roomSceneBound) {
		flag.__roomSceneBound = true;

		document.addEventListener('astro:page-load', sync);
		// Leaving for a page without a room: release the GL context before the canvas goes.
		document.addEventListener('astro:before-swap', (event) => {
			const next = (event as TransitionBeforeSwapEvent).newDocument;
			if (!next.querySelector('[data-room]')) disposeScene();
		});
		window.addEventListener('pagehide', disposeScene);
		// Back/forward cache restore: pagehide disposed the scene, so bring it back.
		window.addEventListener('pageshow', (event) => {
			if (event.persisted) sync();
		});

		// If this module is first evaluated after astro:page-load already fired
		// (navigating from the picker to a room), mount now.
		sync();
	}
</script>
